{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "color": {
      "custom": true,
      "customDuotone": false,
      "customGradient": false,
      "defaultDuotone": false,
      "defaultGradients": false,
      "defaultPalette": false,
      "palette": [
        { "slug": "primary",    "color": "#C0392B", "name": "Primary Red"    },
        { "slug": "secondary",  "color": "#F39C12", "name": "Gold"           },
        { "slug": "accent",     "color": "#1ABC9C", "name": "Aqua (Miami)"   },
        { "slug": "dark",       "color": "#111111", "name": "Dark"           },
        { "slug": "text",       "color": "#222222", "name": "Body Text"      },
        { "slug": "muted",      "color": "#6B6B6B", "name": "Muted"          },
        { "slug": "white",      "color": "#FFFFFF", "name": "White"          },
        { "slug": "surface",    "color": "#F8F9FA", "name": "Surface"        },
        { "slug": "success",    "color": "#27AE60", "name": "Success"        },
        { "slug": "warning",    "color": "#F39C12", "name": "Warning"        },
        { "slug": "error",      "color": "#E74C3C", "name": "Error"          },
        { "slug": "fire",       "color": "#FF6B2B", "name": "Fire Deals"     }
      ]
    },
    "typography": {
      "customFontSize": true,
      "fontFamilies": [
        {
          "name": "Montserrat",
          "slug": "montserrat",
          "fontFamily": "'Montserrat', sans-serif"
        },
        {
          "name": "Oswald",
          "slug": "oswald",
          "fontFamily": "'Oswald', sans-serif"
        },
        {
          "name": "Inter",
          "slug": "inter",
          "fontFamily": "'Inter', sans-serif"
        }
      ],
      "fontSizes": [
        { "slug": "xs",       "size": "0.75rem",  "name": "XS"       },
        { "slug": "sm",       "size": "0.875rem", "name": "SM"       },
        { "slug": "base",     "size": "1rem",     "name": "Base"     },
        { "slug": "lg",       "size": "1.125rem", "name": "LG"       },
        { "slug": "xl",       "size": "1.25rem",  "name": "XL"       },
        { "slug": "2xl",      "size": "1.5rem",   "name": "2XL"      },
        { "slug": "3xl",      "size": "1.875rem", "name": "3XL"      },
        { "slug": "4xl",      "size": "2.25rem",  "name": "4XL"      },
        { "slug": "5xl",      "size": "3rem",     "name": "5XL"      },
        { "slug": "display",  "size": "3.75rem",  "name": "Display"  }
      ]
    },
    "spacing": {
      "blockGap": true,
      "margin": true,
      "padding": true,
      "units": [ "%", "px", "em", "rem", "vh", "vw" ]
    },
    "layout": {
      "contentSize": "880px",
      "wideSize": "1280px"
    },
    "border": {
      "color": true,
      "radius": true,
      "style": true,
      "width": true
    }
  },
  "styles": {
    "color": {
      "background": "#FFFFFF",
      "text": "#222222"
    },
    "typography": {
      "fontFamily": "'Inter', sans-serif",
      "fontSize": "1rem",
      "lineHeight": "1.6"
    },
    "elements": {
      "h1": {
        "typography": {
          "fontFamily": "'Montserrat', sans-serif",
          "fontWeight": "900",
          "lineHeight": "1.1"
        }
      },
      "h2": {
        "typography": {
          "fontFamily": "'Montserrat', sans-serif",
          "fontWeight": "800",
          "lineHeight": "1.2"
        }
      },
      "h3": {
        "typography": {
          "fontFamily": "'Montserrat', sans-serif",
          "fontWeight": "700",
          "lineHeight": "1.3"
        }
      },
      "h4": {
        "typography": {
          "fontFamily": "'Oswald', sans-serif",
          "fontWeight": "600",
          "lineHeight": "1.4"
        }
      },
      "h5": {
        "typography": {
          "fontFamily": "'Oswald', sans-serif",
          "fontWeight": "500"
        }
      },
      "h6": {
        "typography": {
          "fontFamily": "'Oswald', sans-serif",
          "fontWeight": "500"
        }
      },
      "link": {
        "color": {
          "text": "#C0392B"
        },
        ":hover": {
          "color": {
            "text": "#1ABC9C"
          }
        }
      },
      "button": {
        "color": {
          "background": "#C0392B",
          "text": "#FFFFFF"
        },
        "typography": {
          "fontFamily": "'Montserrat', sans-serif",
          "fontWeight": "700"
        },
        "border": {
          "radius": "8px"
        }
      }
    }
  }
}
